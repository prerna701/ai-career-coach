DATABASE_URL="postgresql://postgres:postgres@localhost:5434/aicareercoach?schema=public"

JWT_SECRET="generate-a-random-secret-e.g.-openssl-rand-hex-32"

GEMINI_API_KEY="get-from-https://aistudio.google.com/apikey"

# Free fallback used automatically if Gemini is overloaded/unavailable.
# Get a free key (no card needed) at https://console.groq.com/keys
GROQ_API_KEY="get-from-https://console.groq.com/keys"

# Optional second fallback, only used if you add a paid OpenAI key later.
# OPENAI_API_KEY="sk-..."

# EMAIL_BACKEND=console logs emails to the server console instead of sending
# them over SMTP -- useful for local dev when you just need to read an OTP.
EMAIL_BACKEND="console"
EMAIL_HOST="smtp-relay.brevo.com"
EMAIL_PORT="587"
EMAIL_USER="your-smtp-user"
EMAIL_PASS="your-smtp-password"
EMAIL_FROM="your-verified-sender@example.com"
